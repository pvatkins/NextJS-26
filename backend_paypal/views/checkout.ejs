<!-- backend_paypal/views/checkout.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Coastside ARC - Complete Dues Payment</title>
  
  <!-- Load the Modern PayPal JS SDK securely with your dynamic Client ID -->
  <script src="https://www.paypal.com/sdk/js?client-id=<%= clientId %>&currency=USD"></script>
  
  <style>
    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      background: #f8fafc;
      margin: 0;
    }
    .card {
      background: white;
      padding: 2.5rem;
      border-radius: 12px;
      box-shadow: 0 10px 15px -3px rgba(0,0,0,0.05), 0 4px 6px -4px rgba(0,0,0,0.05);
      width: 100%;
      max-width: 420px;
      text-align: center;
      border: 1px solid #e2e8f0;
    }
    h3 {
      color: #1e3a8a;
      margin-top: 0;
      margin-bottom: 0.5rem;
      font-size: 1.5rem;
    }
    p {
      color: #64748b;
      font-size: 0.95rem;
      line-height: 1.5;
      margin-bottom: 2rem;
    }
    #paypal-button-container {
      margin-top: 1.5rem;
      min-height: 150px;
    }
  </style>
</head>
<body>

  <div class="card">
    <h3>Coastside ARC Dues</h3>
    <p>Please complete your transaction securely via PayPal below:</p>
    
    <!-- Container where PayPal Smart Buttons render -->
    <div id="paypal-button-container"></div>
  </div>

  <script>
    window.addEventListener('load', () => {
      // 1. Verify that the PayPal SDK script loaded correctly
      if (typeof paypal === 'undefined') {
        console.error("❌ Failed to load the PayPal JS SDK script. Check your Client ID string.");
        document.getElementById('paypal-button-container').innerHTML = 
          '<p style="color:red; font-weight:500;">Failed to load payment gateways. Please refresh or try again later.</p>';
        return;
      }

      // 2. Safely parse the tracking code from the URL path segment
      const pathSegments = window.location.pathname.split('/');
      const trackingId = pathSegments[pathSegments.length - 1];
      
      console.log("📌 Local tracking token parsed from URL segment:", trackingId);

      // 3. Render the interactive visual PayPal Smart Buttons
      paypal.Buttons({
        
        // --- Step A: Triggered when user clicks a PayPal button ---
        createOrder: async function() {
          console.log("🚀 Initializing secure session request for tracking token:", trackingId);
          
          try {
            // Absolute routing block directly targeted at port 5556
            const response = await fetch("http://localhost:5556/api/orders", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ trackingToken: trackingId }) 
            });
            
            if (!response.ok) {
              const errorBody = await response.text();
              throw new Error(`Server returned HTTP ${response.status}: ${errorBody}`);
            }

            const order = await response.json();
            console.log("📦 Received Order Creation Response payload:", order);
            
            // Extract official 17-character PayPal session ID string ('id')
            const finalOrderId = order.id; 
            console.log("🔍 Extracted PayPal Order ID for script envelope execution:", finalOrderId);
            
            if (!finalOrderId) {
              throw new Error("The API response did not return a valid PayPal session 'id'.");
            }

            return finalOrderId;

          } catch (err) {
            console.error("❌ createOrder script lifecycle exception encountered:", err.message);
            alert(`Payment Initialization Failed: ${err.message}`);
          }
        },
        
        // --- Step B: Triggered when buyer approves payment inside the modal popup window ---
        onApprove: async function(data, actions) {
          console.log(`💰 Buyer authenticated payment. Settling Order ID token: ${data.orderID}`);
          
          try {
            const response = await fetch(`http://localhost:5556/api/orders/${data.orderID}/capture`, { 
              method: "POST" 
            });
            
            if (!response.ok) {
              const errorBody = await response.text();
              throw new Error(`Server capture returned HTTP ${response.status}: ${errorBody}`);
            }

            const details = await response.json();
            console.log("💰 Settle Capture Response payload received:", details);
            
            if (details.status === "COMPLETED") {
              console.log("✅ Transaction successfully captured! Redirecting browser...");
              // Direct navigation fallback back to NextJS app frontend port 3000
              window.location.href = "http://localhost:3000/paypal-success";
            } else {
              throw new Error(`Transaction state unresolved. Returned status: ${details.status}`);
            }

          } catch (err) {
            console.error("❌ onApprove payment settlement loop crashed:", err.message);
            alert(`Payment Finalization Failed: ${err.message}`);
          }
        },

        // --- Step C: Triggered if the user cancels or closes the window without paying ---
        onCancel: function(data) {
          console.log("⚠️ Transaction tracking session cancelled out by consumer browser window session.", data);
        },

        // --- Step D: Triggered on framework syntax exceptions ---
        onError: function(err) {
          console.error("❌ PayPal SDK visual execution wrapper crashed:", err);
        }

      }).render('#paypal-button-container');
    });
  </script>
</body>
</html>
