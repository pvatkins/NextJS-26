{
  "name": "monorepo-nextjs-paypal-integration",
  "type": "module",
  "version": "1.0.0",
  "description": "Coastside ARC Next.js application with PayPal integration",
  "author": "Paul Atkins",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "backend_paypal"
  ],
  "scripts": {
    "test": "echo \"No tests configured yet\"",
    "clean": "rimraf frontend/.next frontend/out backend/dist backend_paypal/dist",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:backend_paypal": "nodemon --watch backend_paypal/server backend_paypal/server/server.mjs",
    "dev:all": "npm run clean && concurrently \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:backend_paypal\"",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build:backend_paypal": "npm run build --workspace=backend_paypal",
    "build:all": "npm-run-all build:*",
    "lint:frontend": "eslint frontend",
    "lint:backend": "eslint backend",
    "lint:backend_paypal": "eslint backend_paypal",
    "lint:all": "npm-run-all --parallel lint:*",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css,scss,html}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css,scss,html}\" --ignore-path .prettierignore",
    "gallery:generate": "npm run generate-gallery --workspace=frontend",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@next/eslint-plugin-next": "^15.5.4",
    "@types/estree": "^1.0.8",
    "concurrently": "^10.0.3",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "rimraf": "^6.1.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.44.1"
  },
  "dependencies": {
    "ejs": "^6.0.1",
    "react-photo-album": "^3.1.0",
    "yet-another-react-lightbox": "^3.25.0"
  }
}
